# Copy to .env.windows (Git ignored). Use UTF-8 and quote secrets containing # or spaces.
# Credential file paths may be absolute or relative to apps/desktop. Values are not shell-expanded.
DSH_DESKTOP_APP_ID=com.deepseek.harness
DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=
# Required for test releases: 32 lowercase hexadecimal characters from a secure random generator.
# Generate once per release batch; retain it for retries and versions testing upgrades within that batch.
DOWNLOAD_TEST_RELEASE_ID=

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# A local mirror such as https://registry.npmmirror.com speeds up repeated local packages.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com


# The selected mandatory-update origin is required, including unsigned and preparation builds.
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
# Set approved login origins for test builds; omit allowedAuthOrigins for production.
# Optional polling and fallback-page options belong in the same JSON value.
# The fallback-page allowlist defaults to the selected service origin.
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'

# Which deployment an installed client offers in server mode. Baked into the application
# manifest as dshDesktopServerMode, and overridden per machine by the client settings file
# or the DSH_DESKTOP_SERVER_MODE environment variable.
# auto (default) uses DSH_DESKTOP_SERVER_ORIGIN, then DSH_DESKTOP_SERVER_HOST, then the
# address this deployment's launcher names (DSH_LAN_IP), and otherwise the machine's LAN
# address after asking it whether dsh answers there. none bakes no deployment at all.
# DSH_DESKTOP_SERVER_MODE=auto
# DSH_DESKTOP_SERVER_ORIGIN=https://192.168.28.239:8443
# DSH_DESKTOP_SERVER_HOST=
# DSH_DESKTOP_SERVER_PORT=8443
# DSH_DESKTOP_SERVER_LABEL=

# The model route local mode uses, so an installed client reaches the deployment's
# gateway without per-machine setup. The origin defaults to the server-mode
# deployment. DSH_DESKTOP_GATEWAY_TOKEN is a credential: giving it here ships gateway
# access with the installer, which is what makes a client work with no setup at all —
# leave it empty to keep the credential out of the artifact and provision each machine
# with client/provision-client.ps1 instead. none bakes no route.
# DSH_DESKTOP_GATEWAY=auto
# DSH_DESKTOP_GATEWAY_ORIGIN=
# DSH_DESKTOP_GATEWAY_MODELS=deepseek-v4-flash,deepseek-v4-pro
# DSH_DESKTOP_GATEWAY_TOKEN=
# PEM certificate the deployment's TLS terminator chains to, baked as
# dshDesktopGateway.certificateAuthority. Node reads no operating-system trust store, so
# a client behind a self-signed terminator cannot complete the handshake without it.
# Name the authority the terminator signs with, not the leaf it presents: the leaf is
# replaced whenever the terminator renews it.
# DSH_DESKTOP_GATEWAY_CA_FILE=keys/deployment-root.crt

DSH_DESKTOP_WINDOWS_CER_FILE=
DSH_DESKTOP_WINDOWS_SIGNTOOL=
DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
DSH_DESKTOP_WINDOWS_TOKEN_PIN=

# Optional absolute, private local directory; defaults to %USERPROFILE%\.dsh-desktop-signing\signature-cache\v1.
# DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=C:\Users\build\.dsh-desktop-signing\signature-cache\v1

# Cache-hit restore and verification workers (1-8). Hardware signing remains serial.
DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4

# Optional upload configuration; packaging does not require these credentials.
# DOWNLOAD_TEST_COS_BUCKET=
# DOWNLOAD_TEST_COS_SECRET_ID=
# DOWNLOAD_TEST_COS_SECRET_KEY=
# DOWNLOAD_PROD_COS_BUCKET=
# DOWNLOAD_PROD_COS_SECRET_ID=
# DOWNLOAD_PROD_COS_SECRET_KEY=
